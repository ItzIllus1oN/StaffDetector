div #config_screen {
    background-color: #EE151515
    border: 1 4 #FF555555
    size: 250 200
    center: both
    padding: 10

    label #cfg_title {
        inner-text: "StaffRadar Configuration"
        center: horizontal
        text-scale: 1.2
        text-color: #FFAAFF55
        text-shadow: true
        y: 5
    }

    div #cfg_container {
        size: 100% 160
        y: 25
        child-align: none

        div #row_kw {
            size: 100% 12
            y: 0
            child-align: grid
            grid-columns: 2
            checkbox -staffradar:config:keywordEnabled { size: 10 10 border-radius: 2 border: 1 2 #FFAAAAAA padding: 0 }
            label { inner-text: "Enable Keyword Detection" text-color: #FFDDDDDD padding: 0 }
        }

        div #row_sound {
            size: 100% 12
            y: 15
            child-align: grid
            grid-columns: 2
            checkbox -staffradar:config:soundEnabled { size: 10 10 border-radius: 2 border: 1 2 #FFAAAAAA padding: 0 }
            label { inner-text: "Enable Sound Detection" text-color: #FFDDDDDD padding: 0 }
        }

        div #row_chunk {
            size: 100% 12
            y: 30
            child-align: grid
            grid-columns: 2
            checkbox -staffradar:config:chunkEnabled { size: 10 10 border-radius: 2 border: 1 2 #FFAAAAAA padding: 0 }
            label { inner-text: "Enable Chunk Detection" text-color: #FFDDDDDD padding: 0 }
        }

        div #row_kw_label {
            size: 100% 12
            y: 55
            label { inner-text: "Staff Keywords (comma separated):" text-color: #FFAAAAAA text-scale: 0.9 padding: 0 }
        }

        input -staffradar:config:keywords {
            size: 230 14
            y: 65
            background-color: #FF222222
            border: 1 3 #FF555555
            padding: 2
        }

        div #row_th_label {
            size: 100% 12
            y: 90
            label { inner-text: "Watch Threshold (1-10):" text-color: #FFAAAAAA text-scale: 0.9 padding: 0 }
        }

        slider -staffradar:config:threshold {
            size: 230 10
            y: 100
        }
    }

    button #cfg_close {
        inner-text: "Save & Close"
        center: horizontal
        y: 165
        size: 80 16
        border-radius: 4
        background-color: #FF333333
        border: 1 2 #FF777777
        text-color: #FFFFFFFF
        on-click: closeConfig
    }
}
